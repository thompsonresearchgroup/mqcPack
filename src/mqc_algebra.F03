!
      End Function MQC_Matrix_Zero_Thresh
!
!     PROCEDURE MQC_Matrix_Zero_To_Data
!
!>    \brief <b> MQC_Matrix_Zero_To_Data gives a StorZero matrix zero data in the
!>    storage of its first non-zero write</b>
!>
!>    \par Purpose:
!     =============
!>
!>    \verbatim
!>
!>    Option 'symmetric', 'antisymmetric', 'hermitian', 'antihermitian' -> that
!>    packed storage (real symmetric / antisymmetric become StorHerm / StorAhrm,
!>    as in MQC_Allocate_Matrix); 'element' -> StorDiag for a write on the
!>    diagonal of a square matrix (OnDiag), StorNoSym for a non-square matrix,
!>    else StorFull. Dimensions and data type are kept; the data is zero.
!>
!>    \endverbatim
!
!     Arguments:
!     ==========
!>    \param[in,out] Matrix
!>    \verbatim
!>        Matrix is Class(MQC_Matrix), StorZero on input
!>    \endverbatim
!>
!>    \param[in] Option
!>    \verbatim
!>        Option is Character(Len=*): 'element' or a symmetry (lower case)
!>    \endverbatim
!>
!>    \param[in] OnDiag
!>    \verbatim
!>        OnDiag is Logical: the first write is on the diagonal
!>    \endverbatim
!
!     Authors:
!     ========
!>    \author M. M. F. Moraes
!>    \date 2026
!
      Subroutine MQC_Matrix_Zero_To_Data(Matrix,Option,OnDiag)
!
      Implicit None
      Class(MQC_Matrix),Intent(InOut)::Matrix
      Character(Len=*),Intent(In)::Option
      Logical,Intent(In)::OnDiag
      Character(Len=64)::NewStorage,myType
      Integer(kind=int64)::NR,NC
!
      If(Matrix%Storage.ne.'StorZero') Call MQC_Error_A('Matrix not StorZero in &
        &MQC_Matrix_Zero_To_Data', 6, 'Matrix%Storage', Matrix%Storage)
      NR = Matrix%NRow
      NC = Matrix%NCol
      myType = Matrix%Data_Type
      Select Case(Trim(Option))
      Case('symmetric')
        NewStorage = 'StorSymm'
      Case('antisymmetric')
        NewStorage = 'StorAsym'
      Case('hermitian')
        NewStorage = 'StorHerm'
      Case('antihermitian')
        NewStorage = 'StorAhrm'
      Case('element')
        If(NR.ne.NC) then
          NewStorage = 'StorNoSym'
        ElseIf(OnDiag) then
          NewStorage = 'StorDiag'
        Else
          NewStorage = 'StorFull'
        EndIf
      Case Default
        Call MQC_Error_A('Unknown option in MQC_Matrix_Zero_To_Data', 6, 'Option', Option)
      End Select
      Call MQC_Allocate_Matrix(NR,NC,Matrix,myType,NewStorage)
      Select Case(Trim(myType))
      Case('Integer')
        Matrix%MatI = 0
      Case('Real')
        Matrix%MatR = 0.0
      Case('Complex')
        Matrix%MatC = (0.0,0.0)
      Case Default
        Call MQC_Error_A('Matrix type not defined in MQC_Matrix_Zero_To_Data', 6, &
          'myType', myType)
      End Select
!
      End Subroutine MQC_Matrix_Zero_To_Data
!
!     PROCEDURE MQC_Vector_Is_Zero
!
!>    \brief <b> MQC_Vector_Is_Zero tests whether every element of an MQC vector is
!>    zero within a threshold</b>
!>
!>    \par Purpose:
!     =============
!>
!>    \verbatim
!>
!>    TRUE when |v| <= Thresh for every element of the stored data.
!>
!>    \endverbatim
!
!     Arguments:
!     ==========
!>    \param[in] Vector,Thresh
!>    \verbatim
!>        Vector is Type(MQC_Vector); Thresh is Real(kind=real64)
!>    \endverbatim
!
!     Authors:
!     ========
!>    \author M. M. F. Moraes
!>    \date 2026
!
      Function MQC_Vector_Is_Zero(Vector,Thresh) Result(IsZero)
!
      Implicit None
      Type(MQC_Vector),Intent(In)::Vector
      Real(kind=real64),Intent(In)::Thresh
      Logical::IsZero
!
      IsZero = .True.
      If(Allocated(Vector%VecI)) IsZero = IsZero.and.All(Abs(Vector%VecI).le.Thresh)
      If(Allocated(Vector%VecR)) IsZero = IsZero.and.All(Abs(Vector%VecR).le.Thresh)
      If(Allocated(Vector%VecC)) IsZero = IsZero.and.All(Abs(Vector%VecC).le.Thresh)
!
      End Function MQC_Vector_Is_Zero
!
!     PROCEDURE MQC_Matrix_Promote_Type
!
!>    \brief <b> MQC_Matrix_Promote_Type returns the promoted data type of two data
!>    types (Integer < Real < Complex)</b>
!
!     Authors:
!     ========
!>    \author M. M. F. Moraes
!>    \date 2026
!
      Function MQC_Matrix_Promote_Type(T1,T2) Result(T)
!
      Implicit None
      Character(Len=*),Intent(In)::T1,T2
      Character(Len=64)::T
!
      If(Trim(T1).eq.'Complex'.or.Trim(T2).eq.'Complex') then
        T = 'Complex'
      ElseIf(Trim(T1).eq.'Real'.or.Trim(T2).eq.'Real') then
        T = 'Real'
      Else
        T = 'Integer'
      EndIf
!
      End Function MQC_Matrix_Promote_Type
!
!     PROCEDURE MQC_Matrix_As_Type
!
!>    \brief <b> MQC_Matrix_As_Type returns an MQC matrix cast up to a data type,
!>    keeping its storage</b>
!
!     Authors:
!     ========
!>    \author M. M. F. Moraes
!>    \date 2026
!
      Function MQC_Matrix_As_Type(M,T) Result(R)
!
      Implicit None
      Type(MQC_Matrix),Intent(In)::M
      Character(Len=*),Intent(In)::T
      Type(MQC_Matrix)::R
!
      If(Trim(T).eq.'Complex'.and.Trim(M%Data_Type).ne.'Complex') then
        R = MQC_Matrix_Cast_Complex(M)
      ElseIf(Trim(T).eq.'Real'.and.Trim(M%Data_Type).eq.'Integer') then
        R = MQC_Matrix_Cast_Real(M)
      Else
        R = M
      EndIf
!
      End Function MQC_Matrix_As_Type
!
!     PROCEDURE MQC_Matrix_Zero_Matrix
!
!>    \brief <b> MQC_Matrix_Zero_Matrix returns a StorZero matrix of given dimensions
!>    and data type</b>
!
!     Authors:
!     ========
!>    \author M. M. F. Moraes
!>    \date 2026
!
      Function MQC_Matrix_Zero_Matrix(NR,NC,T) Result(R)
!
      Implicit None
      Integer(kind=int64),Intent(In)::NR,NC
      Character(Len=*),Intent(In)::T
      Type(MQC_Matrix)::R
!
      Call MQC_Allocate_Matrix(NR,NC,R,T,'StorZero')
!
      End Function MQC_Matrix_Zero_Matrix
!
!     PROCEDURE MQC_Matrix_Scalar_Zero_Info
!
!>    \brief <b> MQC_Matrix_Scalar_Zero_Info tells whether an optional scalar of
!>    MQC_Matrix_Initialize / MQC_Matrix_Set is exactly zero, and its data type</b>
!>
!>    \par Purpose:
!     =============
!>
!>    \verbatim
!>
!>    Absent scalar: IsZero TRUE, ScaType 'Real' (the zero fill of
!>    MQC_Matrix_Initialize). An explicit scalar counts as zero only when it is
!>    exactly zero (a scalar factor below MQC_very_small is not zero data).
!>    Unknown types: IsZero FALSE (the caller reports the error).
!>
!>    \endverbatim
!
!     Authors:
!     ========
!>    \author M. M. F. Moraes
!>    \date 2026
!
      Subroutine MQC_Matrix_Scalar_Zero_Info(Scalar,IsZero,ScaType)
!
      Implicit None
      Class(*),Optional,Intent(In)::Scalar
      Logical,Intent(Out)::IsZero
      Character(Len=64),Intent(Out)::ScaType
!
      IsZero = .True.
      ScaType = 'Real'
      If(Present(Scalar)) then
        Select Type(Scalar)
        Type is (Integer)
          ScaType = 'Integer'
          IsZero = Scalar.eq.0
        Type is (Real)
          ScaType = 'Real'
          IsZero = Scalar.eq.0.0
        Type is (Complex(kind=real64))
          ScaType = 'Complex'
          IsZero = Scalar.eq.(0.0,0.0)
        Type is (MQC_Scalar)
          ScaType = Scalar%Data_Type
          IsZero = .not.(abs(Scalar).gt.0.0)
        Class Default
          IsZero = .False.
        End Select
      EndIf
!
      End Subroutine MQC_Matrix_Scalar_Zero_Info
!
!     PROCEDURE MQC_Matrix_Full_Zeros
!
!>    \brief <b> MQC_Matrix_Full_Zeros allocates full zero data (StorFull, or
!>    StorNoSym when non-square) for routines that then write the data arrays
!>    directly</b>
!>
!>    \par Purpose:
!     =============
!>
!>    \verbatim
!>
!>    MQC_Matrix_Initialize with a zero scalar gives a StorZero matrix (no data
!>    array); internal routines that fill MatR/MatI/MatC directly use this
!>    instead.
!>
!>    \endverbatim
!
!     Authors:
!     ========
!>    \author M. M. F. Moraes
!>    \date 2026
!
      Subroutine MQC_Matrix_Full_Zeros(M,NR,NC,T)
!
      Implicit None
      Class(MQC_Matrix),Intent(InOut)::M
      Integer(kind=int64),Intent(In)::NR,NC
      Character(Len=*),Intent(In)::T
      Integer(kind=int64)::myNR,myNC
!
      myNR = NR
      myNC = NC
      Call MQC_Allocate_Matrix(myNR,myNC,M,T,'StorFull')
      Select Case(Trim(T))
      Case('Integer')
        M%MatI = 0
      Case('Real')
        M%MatR = 0.0
      Case('Complex')
        M%MatC = (0.0,0.0)
      Case Default
        Call MQC_Error_A('Matrix type not defined in MQC_Matrix_Full_Zeros', 6, 'T', T)
      End Select
!
      End Subroutine MQC_Matrix_Full_Zeros


!
!
!     PROCEDURE MQC_Matrix_Pack
!
!>    \brief <b> MQC_Matrix_Pack stores an MQC matrix in the lower-triangular packed
!>    format of a given symmetry</b>
!>
!>    \par Purpose:
!     =============
!>
!>    \verbatim
!>
!>    MQC_Matrix_Pack stores a square MQC matrix in the packed format of the
!>    requested symmetry, keeping the lower triangle:
!>      'hermitian'     -> StorHerm
!>      'antihermitian' -> StorAhrm
!>      'symmetric'     -> StorSymm
!>      'antisymmetric' -> StorAsym
!>    The elements are not tested: the caller must know that the matrix has the
!>    requested symmetry (e.g. from MQC_Matrix_Test_Symmetric). The data type is
!>    kept, so a real matrix can be stored as StorHerm or StorAhrm.
!>
!>    \endverbatim
!
!     Arguments:
!     ==========
!>    \param[in,out] Matrix
!>    \verbatim
!>        Matrix is Type(MQC_Matrix)
!>        The matrix to be packed.
!>    \endverbatim
!>
!>    \param[in] Symmetry
!>    \verbatim
!>        Symmetry is Character(len=*)
!>        = 'hermitian', 'antihermitian', 'symmetric' or 'antisymmetric'.
!>    \endverbatim
!
!     Authors:
!     ========
!>    \author M. M. F. Moraes
!>    \date 2026
!
      Subroutine MQC_Matrix_Pack(Matrix,Symmetry)
!
!     Variable Declarations.
      Implicit None
      Type(MQC_Matrix),Intent(InOut)::Matrix
      Character(len=*),Intent(In)::Symmetry
      Character(len=64)::mySymmetry
      Character(len=10)::TargetStor
      Real(kind=real64),Dimension(:,:),Allocatable::Temp
      Integer(kind=int64),Dimension(:,:),Allocatable::TempI
      Complex(Kind=real64),Dimension(:,:),Allocatable::TempC
      Integer(kind=int64)::I,J,II,N
!
!     StorZero has every symmetry: nothing to convert
      If(Matrix%Storage.eq.'StorZero') then
        Continue
      Else
      call string_change_case(Symmetry,'l',mySymmetry)
      Select Case (mySymmetry)
      Case ('hermitian')
        TargetStor = 'StorHerm'
      Case ('antihermitian')
        TargetStor = 'StorAhrm'
      Case ('symmetric')
        TargetStor = 'StorSymm'
      Case ('antisymmetric')
        TargetStor = 'StorAsym'
      Case Default
        Call MQC_Error_A('Invalid symmetry sent to MQC_Matrix_Pack', 6, &
             'mySymmetry', mySymmetry )
      End Select
      If(MQC_Matrix_isAllocated(Matrix)) then
  !     Real and integer data use StorHerm/StorAhrm for the symmetric/antisymmetric case.
        If(Matrix%Data_Type.ne.'Complex') then
          If(TargetStor.eq.'StorSymm') TargetStor = 'StorHerm'
          If(TargetStor.eq.'StorAsym') TargetStor = 'StorAhrm'
        EndIf
        If(Matrix%Storage.ne.TargetStor) then
          If(MQC_Matrix_Rows(Matrix).ne.MQC_Matrix_Columns(Matrix)) &
            Call MQC_Error_I('Matrix must be square in MQC_Matrix_Pack', 6, &
                 'MQC_Matrix_Rows(Matrix)', MQC_Matrix_Rows(Matrix), &
                 'MQC_Matrix_Columns(Matrix)', MQC_Matrix_Columns(Matrix) )
          If(Matrix%Storage.eq.'StorDiag') then
            Call MQC_Matrix_Diag2Full(Matrix)
          ElseIf((Matrix%Storage.ne.'StorFull'.and.Matrix%Storage.ne.'StorNoSym')) then
            Call MQC_Matrix_Symm2Full(Matrix)
          EndIf
          N = MQC_Matrix_Rows(Matrix)
          If(Matrix%Data_Type.eq.'Real') then
            Allocate(Temp(N,N))
            Temp = Matrix%MatR
            Call MQC_Deallocate_Matrix(Matrix)
            Call MQC_Allocate_Matrix(N,N,Matrix,'Real',TargetStor)
            Do I = 1, N
              II = (I*(I-1))/2
              Do J = 1, I
                Matrix%MatR(II+J,1) = Temp(I,J)
              EndDo
            EndDo
            Deallocate(Temp)
          ElseIf(Matrix%Data_Type.eq.'Integer') then
            Allocate(TempI(N,N))
            TempI = Matrix%MatI
            Call MQC_Deallocate_Matrix(Matrix)
            Call MQC_Allocate_Matrix(N,N,Matrix,'Integer',TargetStor)
            Do I = 1, N
              II = (I*(I-1))/2
              Do J = 1, I
                Matrix%MatI(II+J,1) = TempI(I,J)
              EndDo
            EndDo
            Deallocate(TempI)
          Else
            Allocate(TempC(N,N))
            TempC = Matrix%MatC
            Call MQC_Deallocate_Matrix(Matrix)
            Call MQC_Allocate_Matrix(N,N,Matrix,'Complex',TargetStor)
            Do I = 1, N
              II = (I*(I-1))/2
              Do J = 1, I
                Matrix%MatC(II+J,1) = TempC(I,J)
              EndDo
            EndDo
            Deallocate(TempC)
          EndIf
        EndIf
      EndIf
!
      EndIf
      End Subroutine MQC_Matrix_Pack
!
!     PROCEDURE MQC_Matrix_Classify
!
!>    \brief <b> MQC_Matrix_Classify tests every symmetry of an MQC matrix and sets
!>    its storage</b>
!>
!>    \par Purpose:
!     =============
!>
!>    \verbatim
!>
!>    For a caller that wants a matrix it already holds labelled. Never demotes
!>    on a single-symmetry test (MQC_Matrix_Test_Symmetric stays a query):
!>      all elements zero (|v| <= MQC_Matrix_Zero_Thresh) -> StorZero
!>      ('fullsymmetric' square, 'asymmetric' non-square);
!>      full data (StorFull or StorNoSym), non-square -> StorNoSym;
!>      full data, square: diagonal -> StorDiag; else the first of symmetric,
!>      hermitian, antisymmetric, antihermitian (the order of MQC_Matrix_Full2Symm)
!>      -> its packed storage
!>      (MQC_Matrix_Pack); none -> StorNoSym ('asymmetric');
!>      packed or diagonal storages are kept (only a zero one becomes StorZero).
!>
!>    \endverbatim
!
!     Arguments:
!     ==========
!>    \param[in,out] Matrix
!>    \verbatim
!>        Matrix is Class(MQC_Matrix), allocated
!>    \endverbatim
!
!     Authors:
!     ========
!>    \author M. M. F. Moraes
!>    \date 2026
!
      Subroutine MQC_Matrix_Classify(Matrix)
!
      Implicit None
      Class(MQC_Matrix),Intent(InOut)::Matrix
      Character(Len=64)::myType
      Integer(kind=int64)::NR,NC
!
      If(.not.MQC_Matrix_isAllocated(Matrix)) Call MQC_Error_A('Unallocated matrix in &
        &MQC_Matrix_Classify', 6, 'Matrix%Storage', Matrix%Storage)
      NR = Matrix%NRow
      NC = Matrix%NCol
      myType = Matrix%Data_Type
      If(Matrix%Storage.eq.'StorZero') then
        Continue
      ElseIf(MQC_Matrix_Check_Zeros(Matrix,MQC_Matrix_Zero_Thresh())) then
        Call MQC_Allocate_Matrix(NR,NC,Matrix,myType,'StorZero')
      ElseIf(Matrix%Storage.eq.'StorFull'.or.Matrix%Storage.eq.'StorNoSym') then
!       same data: test as StorFull (StorNoSym answers .false. to every test)
        Matrix%Storage = 'StorFull'
        If(NR.ne.NC) then
          Matrix%Storage = 'StorNoSym'
        ElseIf(MQC_Matrix_Test_Diagonal(Matrix)) then
          Call MQC_Matrix_Full2Diag(Matrix)
        ElseIf(MQC_Matrix_Test_Symmetric(Matrix,'symmetric')) then
          Call MQC_Matrix_Pack(Matrix,'symmetric')
        ElseIf(MQC_Matrix_Test_Symmetric(Matrix,'hermitian')) then
          Call MQC_Matrix_Pack(Matrix,'hermitian')
        ElseIf(MQC_Matrix_Test_Symmetric(Matrix,'antisymmetric')) then
          Call MQC_Matrix_Pack(Matrix,'antisymmetric')
        ElseIf(MQC_Matrix_Test_Symmetric(Matrix,'antihermitian')) then
          Call MQC_Matrix_Pack(Matrix,'antihermitian')
        Else
          Matrix%Storage = 'StorNoSym'
        EndIf
      EndIf
!
      End Subroutine MQC_Matrix_Classify
!
!
!     PROCEDURE MQC_Matrix_Element_Complex
!
!>    \brief <b> MQC_Matrix_Element_Complex returns element (I,J) of an MQC matrix as
!>    a complex number for any storage</b>
!>
!>    \par Purpose:
!     =============
!>
!>    \verbatim
!>
!>    The element is read directly from the stored data (full, packed or diagonal)
!>    without unpacking the matrix. An unallocated matrix is zero.
!>
!>    \endverbatim
!
!     Authors:
!     ========
!>    \author M. M. F. Moraes
!>    \date 2026
!
      Function MQC_Matrix_Element_Complex(Matrix,I,J) Result(Z)
!
!     Variable Declarations.
      Implicit None
      Type(MQC_Matrix),Intent(In)::Matrix
      Integer(kind=int64),Intent(In)::I,J
      Complex(kind=real64)::Z
      Integer(kind=int64)::K
      Logical::upper
!
      Z = (0.0,0.0)
      If(MQC_Matrix_isAllocated(Matrix)) then
        Select Case (Matrix%Storage)
        Case ('StorZero')
          Z = (0.0,0.0)
        Case ('StorFull','StorNoSym')
          If(Matrix%Data_Type.eq.'Complex') then
            Z = Matrix%MatC(I,J)
          ElseIf(Matrix%Data_Type.eq.'Real') then
            Z = cmplx(Matrix%MatR(I,J),0.0,kind=real64)
          Else
            Z = cmplx(real(Matrix%MatI(I,J),kind=real64),0.0,kind=real64)
          EndIf
        Case ('StorDiag')
          If(I.eq.J) then
            If(Matrix%Data_Type.eq.'Complex') then
              Z = Matrix%MatC(I,1)
            ElseIf(Matrix%Data_Type.eq.'Real') then
              Z = cmplx(Matrix%MatR(I,1),0.0,kind=real64)
            Else
              Z = cmplx(real(Matrix%MatI(I,1),kind=real64),0.0,kind=real64)
            EndIf
          EndIf
        Case ('StorSymm','StorAsym','StorHerm','StorAhrm')
          upper = I.lt.J
          If(upper) then
            K = (J*(J-1))/2+I
          Else
            K = (I*(I-1))/2+J
          EndIf
          If(Matrix%Data_Type.eq.'Complex') then
            Z = Matrix%MatC(K,1)
          ElseIf(Matrix%Data_Type.eq.'Real') then
            Z = cmplx(Matrix%MatR(K,1),0.0,kind=real64)
          Else
            Z = cmplx(real(Matrix%MatI(K,1),kind=real64),0.0,kind=real64)
          EndIf
          If(upper) then
            If(Matrix%Storage.eq.'StorAsym') then
              Z = -Z
            ElseIf(Matrix%Storage.eq.'StorHerm') then
              Z = conjg(Z)
            ElseIf(Matrix%Storage.eq.'StorAhrm') then
              Z = -conjg(Z)
            EndIf
          EndIf
        Case Default
          Call MQC_Error_A('Storage type not defined in MQC_Matrix_Element_Complex', 6, &
               'Matrix%Storage', Matrix%Storage )
        End Select
      EndIf
!
      End Function MQC_Matrix_Element_Complex
!
!
!     PROCEDURE MQC_Matrix_Packed_Block_Join
!
!>    \brief <b> MQC_Matrix_Packed_Block_Join builds a packed matrix from its
!>    diagonal blocks and its lower off-diagonal block</b>
!>
!>    \par Purpose:
!     =============
!>
!>    \verbatim
!>
!>    MQC_Matrix_Packed_Block_Join returns the (NA+NB) x (NA+NB) matrix
!>      | A   .  |
!>      | AB  B  |
!>    in the lower-triangular packed storage of the given symmetry ('hermitian',
!>    'antihermitian', 'symmetric' or 'antisymmetric'). Only the lower triangle is
!>    needed, so it is copied directly from the lower triangles of A and B and from
!>    all of AB (NB x NA); the upper triangle follows from the symmetry. A and B are
!>    usually stored packed already and are read without unpacking. Unallocated
!>    blocks are zero. The result is complex if any block is complex.
!>
!>    \endverbatim
!
!     Authors:
!     ========
!>    \author M. M. F. Moraes
!>    \date 2026
!
      Function MQC_Matrix_Packed_Block_Join(A,AB,B,NA,NB,Symmetry) Result(C)
!
!     Variable Declarations.
      Implicit None
      Type(MQC_Matrix),Intent(In)::A,AB,B
      Integer(kind=int64),Intent(In)::NA,NB
      Character(len=*),Intent(In)::Symmetry
      Type(MQC_Matrix)::C
      Character(len=64)::mySymmetry
      Character(len=10)::TargetStor
      Logical::isComplex
      Integer(kind=int64)::I,J,N,II
      Complex(kind=real64)::Z
!
      call string_change_case(Symmetry,'l',mySymmetry)
      Select Case (mySymmetry)
      Case ('hermitian')
        TargetStor = 'StorHerm'
      Case ('antihermitian')
        TargetStor = 'StorAhrm'
      Case ('symmetric')
        TargetStor = 'StorSymm'
      Case ('antisymmetric')
        TargetStor = 'StorAsym'
      Case Default
        Call MQC_Error_A('Invalid symmetry sent to MQC_Matrix_Packed_Block_Join', 6, &
             'mySymmetry', mySymmetry )
      End Select
      N = NA + NB
      isComplex = .false.
      If(MQC_Matrix_isAllocated(A)) isComplex = isComplex.or.A%Data_Type.eq.'Complex'
      If(MQC_Matrix_isAllocated(AB)) isComplex = isComplex.or.AB%Data_Type.eq.'Complex'
      If(MQC_Matrix_isAllocated(B)) isComplex = isComplex.or.B%Data_Type.eq.'Complex'
      If(isComplex) then
        Call MQC_Allocate_Matrix(N,N,C,'Complex',TargetStor)
      Else
        Call MQC_Allocate_Matrix(N,N,C,'Real',TargetStor)
      EndIf
      Do I = 1, N
        II = (I*(I-1))/2
        Do J = 1, I
          If(I.le.NA) then
            Z = MQC_Matrix_Element_Complex(A,I,J)
          ElseIf(J.le.NA) then
            Z = MQC_Matrix_Element_Complex(AB,I-NA,J)
          Else
            Z = MQC_Matrix_Element_Complex(B,I-NA,J-NA)
          EndIf
          If(isComplex) then
            C%MatC(II+J,1) = Z
          Else
            C%MatR(II+J,1) = real(Z)
          EndIf
        EndDo
      EndDo
!
      End Function MQC_Matrix_Packed_Block_Join
!
!
!     PROCEDURE MQC_Matrix_Packed_Block_Split
!
!>    \brief <b> MQC_Matrix_Packed_Block_Split splits a packed matrix into its
!>    diagonal blocks and its lower off-diagonal block</b>
!>
!>    \par Purpose:
!     =============
!>
!>    \verbatim
!>
!>    MQC_Matrix_Packed_Block_Split is the inverse of MQC_Matrix_Packed_Block_Join.
!>    The (NA+NB) x (NA+NB) packed matrix
!>      | A   .  |
!>      | AB  B  |
!>    is split into A (NA x NA) and B (NB x NB), returned in the packed storage of C,
!>    and AB (NB x NA), returned in StorFull. All three lie in the stored lower
!>    triangle, so nothing is unpacked; the upper off-diagonal block is implied by
!>    the symmetry and is not formed. A is the first NA(NA+1)/2 packed elements. A
!>    block with a zero dimension is left unallocated. A diagonal (StorDiag) C gives
!>    diagonal A and B and no AB (it is zero).
!>
!>    \endverbatim
!
!     Authors:
!     ========
!>    \author M. M. F. Moraes
!>    \date 2026
!
      Subroutine MQC_Matrix_Packed_Block_Split(C,NA,NB,A,AB,B)
!
!     Variable Declarations.
      Implicit None
      Type(MQC_Matrix),Intent(In)::C
      Integer(kind=int64),Intent(In)::NA,NB
      Type(MQC_Matrix),Intent(Out)::A,AB,B
      Integer(kind=int64)::I,J,II,IC
!
!     StorZero operand: result without the storage dispatch
      If(C%Storage.eq.'StorZero') then
        If(MQC_Matrix_Rows(C).ne.NA+NB) &
          Call MQC_Error_I('Block dimensions do not match C in MQC_Matrix_Packed_Block_Split', 6, &
               'MQC_Matrix_Rows(C)', MQC_Matrix_Rows(C), 'NA', NA, 'NB', NB )
        A = MQC_Matrix_Zero_Matrix(NA,NA,C%Data_Type)
        AB = MQC_Matrix_Zero_Matrix(NB,NA,C%Data_Type)
        B = MQC_Matrix_Zero_Matrix(NB,NB,C%Data_Type)
      Else
      Select Case (C%Storage)
      Case ('StorHerm','StorAhrm','StorSymm','StorAsym')
        If(MQC_Matrix_Rows(C).ne.NA+NB) &
          Call MQC_Error_I('Block dimensions do not match C in MQC_Matrix_Packed_Block_Split', 6, &
               'MQC_Matrix_Rows(C)', MQC_Matrix_Rows(C), 'NA', NA, 'NB', NB )
        If(NA.gt.0) then
          Call MQC_Allocate_Matrix(NA,NA,A,C%Data_Type,C%Storage)
          Select Case (C%Data_Type)
          Case ('Real')
            A%MatR(:,1) = C%MatR(1:(NA*(NA+1))/2,1)
          Case ('Integer')
            A%MatI(:,1) = C%MatI(1:(NA*(NA+1))/2,1)
          Case ('Complex')
            A%MatC(:,1) = C%MatC(1:(NA*(NA+1))/2,1)
          Case Default
            Call MQC_Error_A('Unknown data type in MQC_Matrix_Packed_Block_Split', 6, &
                 'C%Data_Type', C%Data_Type )
          End Select
        EndIf
        If(NB.gt.0) then
          Call MQC_Allocate_Matrix(NB,NB,B,C%Data_Type,C%Storage)
          Do I = 1, NB
            II = (I*(I-1))/2
            IC = ((NA+I)*(NA+I-1))/2 + NA
            Select Case (C%Data_Type)
            Case ('Real')
              B%MatR(II+1:II+I,1) = C%MatR(IC+1:IC+I,1)
            Case ('Integer')
              B%MatI(II+1:II+I,1) = C%MatI(IC+1:IC+I,1)
            Case ('Complex')
              B%MatC(II+1:II+I,1) = C%MatC(IC+1:IC+I,1)
            Case Default
              Call MQC_Error_A('Unknown data type in MQC_Matrix_Packed_Block_Split', 6, &
                   'C%Data_Type', C%Data_Type )
            End Select
          EndDo
        EndIf
        If(NA.gt.0.and.NB.gt.0) then
          Call MQC_Allocate_Matrix(NB,NA,AB,C%Data_Type,'StorFull')
          Do I = 1, NB
            IC = ((NA+I)*(NA+I-1))/2
            Do J = 1, NA
              Select Case (C%Data_Type)
              Case ('Real')
                AB%MatR(I,J) = C%MatR(IC+J,1)
              Case ('Integer')
                AB%MatI(I,J) = C%MatI(IC+J,1)
              Case ('Complex')
                AB%MatC(I,J) = C%MatC(IC+J,1)
              Case Default
                Call MQC_Error_A('Unknown data type in MQC_Matrix_Packed_Block_Split', 6, &
                     'C%Data_Type', C%Data_Type )
              End Select
            EndDo
          EndDo
        EndIf
      Case ('StorDiag')
        If(MQC_Matrix_Rows(C).ne.NA+NB) &
          Call MQC_Error_I('Block dimensions do not match C in MQC_Matrix_Packed_Block_Split', 6, &
               'MQC_Matrix_Rows(C)', MQC_Matrix_Rows(C), 'NA', NA, 'NB', NB )
        If(NA.gt.0) then
          Call MQC_Allocate_Matrix(NA,NA,A,C%Data_Type,'StorDiag')
          Select Case (C%Data_Type)
          Case ('Real')
            A%MatR(:,1) = C%MatR(1:NA,1)
          Case ('Integer')
            A%MatI(:,1) = C%MatI(1:NA,1)
          Case ('Complex')
            A%MatC(:,1) = C%MatC(1:NA,1)
          Case Default
            Call MQC_Error_A('Unknown data type in MQC_Matrix_Packed_Block_Split', 6, &
                 'C%Data_Type', C%Data_Type )
          End Select
        EndIf
        If(NB.gt.0) then
          Call MQC_Allocate_Matrix(NB,NB,B,C%Data_Type,'StorDiag')
          Select Case (C%Data_Type)
          Case ('Real')
            B%MatR(:,1) = C%MatR(NA+1:NA+NB,1)
          Case ('Integer')
            B%MatI(:,1) = C%MatI(NA+1:NA+NB,1)
          Case ('Complex')
            B%MatC(:,1) = C%MatC(NA+1:NA+NB,1)
          Case Default
            Call MQC_Error_A('Unknown data type in MQC_Matrix_Packed_Block_Split', 6, &
                 'C%Data_Type', C%Data_Type )
          End Select
        EndIf
      Case Default
        Call MQC_Error_A('C must be packed or diagonal in MQC_Matrix_Packed_Block_Split', 6, &
             'C%Storage', C%Storage )
      End Select
!
      EndIf
      End Subroutine MQC_Matrix_Packed_Block_Split
!
!
!     PROCEDURE MQC_Vector_Diagonal_Symmetry
!
!>    \brief <b> MQC_Vector_Diagonal_Symmetry returns the symmetry of the diagonal
!>    matrix built from an MQC vector</b>
!>
!>    \par Purpose:
!     =============
!>
!>    \verbatim
!>
!>    Returns 'hermitian' when every element is real, 'antihermitian' when every
!>    element is imaginary and 'unknown' otherwise. The threshold is MQC_very_small
!>    (1e-10 when it is not positive), relative to max(1,|element|).
!>
!>    \endverbatim
!
!     Authors:
!     ========
!>    \author M. M. F. Moraes
!>    \date 2026
!
      Function MQC_Vector_Diagonal_Symmetry(Vector) Result(Symmetry)
!
!     Variable Declarations.
      Implicit None
      Type(MQC_Vector),Intent(In)::Vector
      Character(len=16)::Symmetry
      Logical::realOK,imagOK
      Real(kind=real64)::thresh,myscale
      Integer(kind=int64)::I
!
      If(MQC_very_small.gt.0.0) then
        thresh = MQC_very_small
      Else
        thresh = 1e-10
      EndIf
      If(Vector%Data_Type.ne.'Complex') then
        Symmetry = 'hermitian'
      Else
        realOK = .true.
        imagOK = .true.
        Do I = 1, Vector%Length
          myscale = thresh*max(1.0,abs(Vector%VecC(I)))
          If(abs(aimag(Vector%VecC(I))).gt.myscale) realOK = .false.
          If(abs(real(Vector%VecC(I))).gt.myscale) imagOK = .false.
        EndDo
        If(realOK) then
          Symmetry = 'hermitian'
        ElseIf(imagOK) then
          Symmetry = 'antihermitian'
        Else
          Symmetry = 'unknown'
        EndIf
      EndIf
!
      End Function MQC_Vector_Diagonal_Symmetry
!
!
!     PROCEDURE MQC_Matrix_Diag_Join
!
!>    \brief <b> MQC_Matrix_Diag_Join builds a diagonal (StorDiag) matrix from the
!>    diagonals of two square blocks</b>
!>
!>    \par Purpose:
!     =============
!>
!>    \verbatim
!>
!>    Returns the (NA+NB) x (NA+NB) StorDiag matrix whose diagonal is the diagonal of
!>    DA followed by the diagonal of DB (any storage, read without unpacking).
!>    Unallocated blocks are zero. The result is complex if any block is complex.
!>
!>    \endverbatim
!
!     Authors:
!     ========
!>    \author M. M. F. Moraes
!>    \date 2026
!
      Function MQC_Matrix_Diag_Join(DA,DB,NA,NB) Result(C)
!
!     Variable Declarations.
      Implicit None
      Type(MQC_Matrix),Intent(In)::DA,DB
      Integer(kind=int64),Intent(In)::NA,NB
      Type(MQC_Matrix)::C
      Logical::isComplex
      Integer(kind=int64)::I,N
      Complex(kind=real64)::Z
!
      N = NA + NB
      isComplex = .false.
      If(MQC_Matrix_isAllocated(DA)) isComplex = isComplex.or.DA%Data_Type.eq.'Complex'
      If(MQC_Matrix_isAllocated(DB)) isComplex = isComplex.or.DB%Data_Type.eq.'Complex'
      If(isComplex) then
        Call MQC_Allocate_Matrix(N,N,C,'Complex','StorDiag')
      Else
        Call MQC_Allocate_Matrix(N,N,C,'Real','StorDiag')
      EndIf
      Do I = 1, N
        If(I.le.NA) then
          Z = MQC_Matrix_Element_Complex(DA,I,I)
        Else
          Z = MQC_Matrix_Element_Complex(DB,I-NA,I-NA)
        EndIf
        If(isComplex) then
          C%MatC(I,1) = Z
        Else
          C%MatR(I,1) = real(Z)
        EndIf
      EndDo
!
      End Function MQC_Matrix_Diag_Join
