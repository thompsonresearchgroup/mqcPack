!
!     PROCEDURE MQC_Matrix_Get_Symmetry
!
!>    \brief <b> MQC_Matrix_Get_Symmetry returns the symmetry implied by the storage
!>    format of an MQC matrix</b>
!>
!>    \par Purpose:
!     =============
!>
!>    \verbatim
!>
!>    MQC_Matrix_Get_Symmetry returns the symmetry that the storage format of an MQC
!>    matrix guarantees, without testing the elements:
!>      StorSymm -> 'symmetric'
!>      StorAsym -> 'antisymmetric'
!>      StorHerm -> 'hermitian'
!>      StorAhrm -> 'antihermitian'
!>      StorDiag -> 'diagonal'
!>      StorNoSym -> 'asymmetric' (full data, known to have no symmetry)
!>      StorZero -> 'fullsymmetric' (square) or 'asymmetric' (non-square)
!>      StorFull -> 'unknown' (no symmetry known; use MQC_Matrix_Test_Symmetric)
!>    An unallocated matrix returns 'unallocated'. A real symmetric (antisymmetric)
!>    matrix is also hermitian (antihermitian).
!>
!>    \endverbatim
!
!     Arguments:
!     ==========
!>    \param[in] Matrix
!>    \verbatim
!>        Matrix is Class(MQC_Matrix)
!>        The MQC matrix to be queried.
!>    \endverbatim
!
!     Authors:
!     ========
!>    \author M. M. F. Moraes
!>    \date 2026
!
      Function MQC_Matrix_Get_Symmetry(Matrix) Result(Symmetry)
!
!     Variable Declarations.
      Implicit None
      Class(MQC_Matrix),Intent(In)::Matrix
      Character(len=16)::Symmetry
!
      If(.not.MQC_Matrix_isAllocated(Matrix)) then
        Symmetry = 'unallocated'
      Else
        Select Case (Matrix%Storage)
        Case ('StorSymm')
          Symmetry = 'symmetric'
        Case ('StorAsym')
          Symmetry = 'antisymmetric'
        Case ('StorHerm')
          Symmetry = 'hermitian'
        Case ('StorAhrm')
          Symmetry = 'antihermitian'
        Case ('StorDiag')
          Symmetry = 'diagonal'
        Case ('StorNoSym')
          Symmetry = 'asymmetric'
        Case ('StorZero')
          If(Matrix%NRow.eq.Matrix%NCol) then
            Symmetry = 'fullsymmetric'
          Else
            Symmetry = 'asymmetric'
          EndIf
        Case ('StorFull')
          Symmetry = 'unknown'
        Case Default
          Call MQC_Error_A('Storage type unrecognized in MQC_Matrix_Get_Symmetry', 6, &
             'Matrix%Storage', Matrix%Storage )
        End Select
      EndIf
!
      End Function MQC_Matrix_Get_Symmetry
!
!     PROCEDURE MQC_Matrix_Zero_Element
!
!>    \brief <b> MQC_Matrix_Zero_Element returns a zero MQC scalar of a matrix data
!>    type</b>
!>
!>    \par Purpose:
!     =============
!>
!>    \verbatim
!>
!>    Element of a StorZero matrix: 0, 0.0 or (0.0,0.0) for Data_Type 'Integer',
!>    'Real' or 'Complex'.
!>
!>    \endverbatim
!
!     Arguments:
!     ==========
!>    \param[in] Data_Type
!>    \verbatim
!>        Data_Type is Character(Len=*), the matrix data type
!>    \endverbatim
!
!     Authors:
!     ========
!>    \author M. M. F. Moraes
!>    \date 2026
!
      Function MQC_Matrix_Zero_Element(Data_Type) Result(Element)
!
      Implicit None
      Character(Len=*),Intent(In)::Data_Type
      Type(MQC_Scalar)::Element
      Integer(kind=int64)::zeroI
      Real(kind=real64)::zeroR
      Complex(kind=real64)::zeroC
!
      zeroI = 0
      zeroR = 0.0
      zeroC = (0.0,0.0)
      Select Case(Trim(Data_Type))
      Case('Integer')
        Element = zeroI
      Case('Real')
        Element = zeroR
      Case('Complex')
        Element = zeroC
      Case Default
        Call MQC_Error_A('Matrix type not defined in MQC_Matrix_Zero_Element', 6, &
          'Data_Type', Data_Type)
      End Select
!
      End Function MQC_Matrix_Zero_Element
