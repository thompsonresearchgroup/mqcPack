!>    \endverbatim
!
!     Authors:
!     ========
!>    \author L. M. Thompson
!>    \date 2022
!
      function mqc_R4Tensor_complex_realPart(A) result(output)
!
      Implicit None
      class(mqc_R4Tensor),intent(in)::A
      type(mqc_R4Tensor)::output
      integer(kind=int64)::i
!
!     Do the work.
!
      output = A
