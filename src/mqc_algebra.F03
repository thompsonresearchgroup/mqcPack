                enddo
              enddo
            else if (B%storage .eq. 'StorDiag') then
              call mqc_allocate_matrix(A%NRow,A%NCol,C,'Complex','StorDiag')
              do i = 1, A%NRow
                C%matC(i,1) = A%matI(i,i) * B%matC(i,1)
              enddo
            endif
          else if (A%storage .eq. 'StorSymm') then
