!>    \author X. Sheng, M. M. F. Moraes
!>    \date 2017, 2026
!
      Function MQC_ElementMatrixDivide_Stored(A,B) Result(C)
!
      implicit none
      type(mqc_matrix),intent(in)::A,B
      type(mqc_matrix)::C,Tmp1
