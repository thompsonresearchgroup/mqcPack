!
!>    \par Purpose:
!     =============
!>
!>    \verbatim
!>       
!>    MQC_Scalar_Sign returns the absolute value of the first argument times the sign 
!>    of the second argument.
!>
!>    \endverbatim
!
!     Arguments:
!     ==========
!>    \param[in] Scalar1
!>    \verbatim 
!>        Scalar1 is Type(MQC_Scalar)
