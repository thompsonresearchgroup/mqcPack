        Call MQC_Error_A('ScalarIn type not assigned in MQC_Scalar2Scalar', 6, &
             'ScalarIn%Data_type', ScalarIn%Data_type )
      EndIf
!
      Return
      End Subroutine MQC_Output_MQCScalar_Scalar
