          Call MQC_Allocate_Matrix(MA%nrow,MB%ncol,MC,'Complex','StorFull')
          Tmp1 = MB
          Call MQC_Matrix_Symm2Full(Tmp1)
          MC%MatC = MatMul(MA%MatC,Tmp1%MatC)
          Call MQC_Deallocate_Matrix(Tmp1)
        ElseIf ((MA%Storage.eq.'StorFull'.or.MA%Storage.eq.'StorNoSym').and.MB%Storage.eq.'StorDiag') then
          Call MQC_Allocate_Matrix(MA%nrow,MB%ncol,MC,'Complex','StorFull')
          Tmp1 = MB
          Call MQC_Matrix_Diag2Full(Tmp1)
          MC%MatC = MatMul(MA%MatC,Tmp1%MatC)
          Call MQC_Deallocate_Matrix(Tmp1)
        ElseIf ((MA%Storage.eq.'StorSymm' .or. MA%Storage.eq.'StorAsym' .or. &
          MA%Storage.eq.'StorHerm' .or. MA%Storage.eq.'StorAhrm') .and. &
           (MB%Storage.eq.'StorFull'.or.MB%Storage.eq.'StorNoSym')) then
          Call MQC_Allocate_Matrix(MA%nrow,MB%ncol,MC,'Complex','StorFull')
          Tmp1 = MA
          Call MQC_Matrix_Symm2Full(Tmp1)
          MC%MatC = MatMul(Tmp1%MatC,MB%MatC)
          Call MQC_Deallocate_Matrix(Tmp1)
        ElseIf ((MA%Storage.eq.'StorSymm' .or. MA%Storage.eq.'StorAsym' .or. &
          MA%Storage.eq.'StorHerm' .or. MA%Storage.eq.'StorAhrm') .and. &
          (MB%Storage.eq.'StorSymm' .or. MB%Storage.eq.'StorAsym' .or. &
          MB%Storage.eq.'StorHerm' .or. MB%Storage.eq.'StorAhrm')) then
          Call MQC_Allocate_Matrix(MA%nrow,MB%ncol,MC,'Complex','StorFull')
          Tmp1 = MA
          Tmp2 = MB
          Call MQC_Matrix_Symm2Full(Tmp1)
          Call MQC_Matrix_Symm2Full(Tmp2)
          MC%MatC = MatMul(Tmp1%MatC,Tmp2%MatC)
          Call MQC_Deallocate_Matrix(Tmp1)
          Call MQC_Deallocate_Matrix(Tmp2)
        ElseIf ((MA%Storage.eq.'StorSymm' .or. MA%Storage.eq.'StorAsym' .or. &
          MA%Storage.eq.'StorHerm' .or. MA%Storage.eq.'StorAhrm') .and. &
           MB%Storage.eq.'StorDiag') then
          Call MQC_Allocate_Matrix(MA%nrow,MB%ncol,MC,'Complex','StorFull')
          Tmp1 = MA
          Tmp2 = MB
          Call MQC_Matrix_Symm2Full(Tmp1)
          Call MQC_Matrix_Diag2Full(Tmp2)
          MC%MatC = MatMul(Tmp1%MatC,Tmp2%MatC)
          Call MQC_Deallocate_Matrix(Tmp1)
          Call MQC_Deallocate_Matrix(Tmp2)
        ElseIf (MA%Storage.eq.'StorDiag' .and. (MB%Storage.eq.'StorFull'.or.MB%Storage.eq.'StorNoSym')) then
          Call MQC_Allocate_Matrix(MA%nrow,MB%ncol,MC,'Complex','StorFull')
          Tmp1 = MA
          Call MQC_Matrix_Diag2Full(Tmp1)
          MC%MatC = MatMul(Tmp1%MatC,MB%MatC)
          Call MQC_Deallocate_Matrix(Tmp1)
        ElseIf (MA%Storage.eq.'StorDiag' .and. (MB%Storage.eq.'StorSymm' .or. &
          MB%Storage.eq.'StorAsym' .or. MB%Storage.eq.'StorHerm' .or. &
          MA%Storage.eq.'StorAhrm')) then
          Call MQC_Allocate_Matrix(MA%nrow,MB%ncol,MC,'Complex','StorFull')
          Tmp1 = MA
          Tmp2 = MB
          Call MQC_Matrix_Diag2Full(Tmp1)
          Call MQC_Matrix_Symm2Full(Tmp2)
          MC%MatC = MatMul(Tmp1%MatC,Tmp2%MatC)
          Call MQC_Deallocate_Matrix(Tmp1)
          Call MQC_Deallocate_Matrix(Tmp2)
        ElseIf (MA%Storage.eq.'StorDiag' .and. MB%Storage.eq.'StorDiag') then
          Call MQC_Allocate_Matrix(MA%nrow,MB%ncol,MC,'Complex','StorDiag')
          MC%MatC = MA%matC * MB%matC 
        EndIf
      EndIf

      EndIf
      End Function MQC_MatrixMatrixDotProduct
!
!     PROCEDURE MQC_Matrix_Hermitian_Sandwich
!
!>    \brief <b> MQC_Matrix_Hermitian_Sandwich returns C = dagger(B) A B, using the
!>    Hermitian or anti-Hermitian structure of A when it is known</b>
!>
!>    \par Purpose:
!     =============
!>
!>    \verbatim
!>
!>    The structure of A is taken from its storage type:
!>      StorHerm with a real diagonal, real StorSymm         -> Hermitian
!>      StorAhrm with an imaginary diagonal, real StorAsym  -> anti-Hermitian
!>      StorFull/StorDiag: Hermitian if MQC_Matrix_Test_Symmetric(A,'hermitian',.true.)
!>      anything else                                    -> full
!>    With ForceSym the structure is taken from ForceSym and A is not tested; the
!>    caller must know that A has it (e.g. from the symmetry flag of an integral).
!>    For a Hermitian (anti-Hermitian) A, T = A B is formed with ZHEMM (ZGEMM), or DGEMM if real,
!>    and only the lower triangle of C = dagger(B) T is formed with ZGEMMT/DGEMMT. C is
!>    returned packed: StorHerm/StorAhrm (real data included).
!>    The full case is MatMul(Dagger(B),MatMul(A,B)) in StorFull.
!>
!>    \endverbatim
!
!     Arguments:
!     ==========
!>    \param[in] A
!>    \verbatim
!>        A is type(MQC_Matrix)
!>        Square n x n matrix.
!>    \endverbatim
!>
!>    \param[in] B
!>    \verbatim
!>        B is type(MQC_Matrix)
!>        n x m matrix.
!>    \endverbatim
!>
!>    \param[in] ForceSym
!>    \verbatim
!>        ForceSym is Character(len=*),Optional
!>        = 'hermitian':     A is Hermitian (the matrix is not tested)
!>        = 'antihermitian': A is anti-Hermitian (the matrix is not tested)
!>    \endverbatim
!
!     Authors:
!     ========
!>    \author M. M. F. Moraes
!>    \date 2026
!
      Function MQC_Matrix_Hermitian_Sandwich(A,B,ForceSym) Result(C)
      Implicit None
      Type(MQC_Matrix),Intent(In)::A,B
      Character(len=*),Optional,Intent(In)::ForceSym
      Type(MQC_Matrix)::C
      Type(MQC_Matrix)::Af,Bf
      Character(len=16)::structure
      Character(len=64)::myForceSym
      Integer(kind=int64)::I,J,M,N,II
      Integer(kind=MQC_BlasInt)::N32,M32
      Real(kind=real64)::oneR,zeroR
      Complex(kind=real64)::oneC,zeroC
      Real(kind=real64),Dimension(:,:),Allocatable::AR,BR,TR,CR
      Complex(kind=real64),Dimension(:,:),Allocatable::AC,BC,TC,CC
!
!     StorZero operand: result without the storage dispatch
      If(A%Storage.eq.'StorZero'.or.B%Storage.eq.'StorZero') then
!       C = dagger(B) A B
        If(A%NCol.ne.B%NRow) Call MQC_Error_I('Matrices are not conformable in &
          &MQC_Matrix_Hermitian_Sandwich', 6, 'A%NCol', A%NCol, 'B%NRow', B%NRow)
        C = MQC_Matrix_Zero_Matrix(B%NCol,B%NCol,MQC_Matrix_Promote_Type(A%Data_Type,B%Data_Type))
      Else
      structure = 'full'
      If(Present(ForceSym)) then
        If(MQC_Matrix_Rows(A).ne.MQC_Matrix_Columns(A)) &
          Call MQC_Error_I('A must be square with ForceSym in MQC_Matrix_Hermitian_Sandwich', 6, &
               'MQC_Matrix_Rows(A)', MQC_Matrix_Rows(A), &
               'MQC_Matrix_Columns(A)', MQC_Matrix_Columns(A) )
        call string_change_case(ForceSym,'l',myForceSym)
        Select Case (myForceSym)
        Case ('hermitian','antihermitian')
          structure = myForceSym
        Case Default
          Call MQC_Error_A('Invalid ForceSym sent to MQC_Matrix_Hermitian_Sandwich', 6, &
               'myForceSym', myForceSym )
        End Select
      ElseIf(MQC_Matrix_Rows(A).eq.MQC_Matrix_Columns(A)) then
!       The structure is tested in the mathematical sense (Math = .true.): the
!       Hermitian path (ZHEMM, real diagonal of C) needs a real diagonal of A and the
!       anti-Hermitian path an imaginary one. For packed storage only the diagonal is
!       checked (O(n)).
        Select Case (A%Storage)
        Case ('StorHerm')
          If(MQC_Matrix_Test_Symmetric(A,'hermitian',.true.)) structure = 'hermitian'
        Case ('StorSymm')
          If(.not.MQC_Matrix_HaveComplex(A)) structure = 'hermitian'
        Case ('StorAhrm')
          If(MQC_Matrix_Test_Symmetric(A,'antihermitian',.true.)) structure = 'antihermitian'
        Case ('StorAsym')
          If(.not.MQC_Matrix_HaveComplex(A)) structure = 'antihermitian'
        Case ('StorDiag','StorFull')
          If(MQC_Matrix_Test_Symmetric(A,'hermitian',.true.)) structure = 'hermitian'
        End Select
      EndIf
!
      If(structure.eq.'full') then
        C = MatMul(Dagger(B),MatMul(A,B))
      Else
        Af = A
        Bf = B
        If(Af%Storage.eq.'StorDiag') then
          Call MQC_Matrix_Diag2Full(Af)
        ElseIf((Af%Storage.ne.'StorFull'.and.Af%Storage.ne.'StorNoSym')) then
          Call MQC_Matrix_Symm2Full(Af)
        EndIf
        If(Bf%Storage.eq.'StorDiag') then
          Call MQC_Matrix_Diag2Full(Bf)
        ElseIf((Bf%Storage.ne.'StorFull'.and.Bf%Storage.ne.'StorNoSym')) then
          Call MQC_Matrix_Symm2Full(Bf)
        EndIf
        N = MQC_Matrix_Rows(Bf)
        M = MQC_Matrix_Columns(Bf)
        N32 = int(N,kind=MQC_BlasInt)
        M32 = int(M,kind=MQC_BlasInt)
  !
        If(MQC_Matrix_HaveComplex(Af).or.MQC_Matrix_HaveComplex(Bf)) then
          oneC = (1.0,0.0)
          zeroC = (0.0,0.0)
          Allocate(AC(N,N),BC(N,M),TC(N,M),CC(M,M))
          If(MQC_Matrix_HaveComplex(Af)) then
            AC = Af%MatC
          ElseIf(MQC_Matrix_HaveReal(Af)) then
            AC = cmplx(Af%MatR,0.0,kind=real64)
          Else
            AC = cmplx(real(Af%MatI,kind=real64),0.0,kind=real64)
          EndIf
          If(MQC_Matrix_HaveComplex(Bf)) then
            BC = Bf%MatC
          ElseIf(MQC_Matrix_HaveReal(Bf)) then
            BC = cmplx(Bf%MatR,0.0,kind=real64)
          Else
            BC = cmplx(real(Bf%MatI,kind=real64),0.0,kind=real64)
          EndIf
          If(structure.eq.'hermitian') then
            call ZHEMM('L','L',N32,M32,oneC,AC,N32,BC,N32,zeroC,TC,N32)
          Else
            call ZGEMM('N','N',N32,M32,N32,oneC,AC,N32,BC,N32,zeroC,TC,N32)
          EndIf
          CC = zeroC
          call ZGEMMT('L','C','N',M32,N32,oneC,BC,N32,TC,N32,zeroC,CC,M32)
          If(structure.eq.'hermitian') then
            Call MQC_Allocate_Matrix(M,M,C,'Complex','StorHerm')
          Else
            Call MQC_Allocate_Matrix(M,M,C,'Complex','StorAhrm')
          EndIf
          Do I = 1, M
            II = (I*(I-1))/2
            Do J = 1, I-1
              C%MatC(II+J,1) = CC(I,J)
            EndDo
            If(structure.eq.'hermitian') then
              C%MatC(II+I,1) = cmplx(real(CC(I,I)),0.0,kind=real64)
            Else
              C%MatC(II+I,1) = cmplx(0.0,aimag(CC(I,I)),kind=real64)
            EndIf
          EndDo
        Else
          oneR = 1.0
          zeroR = 0.0
          Allocate(AR(N,N),BR(N,M),TR(N,M),CR(M,M))
          If(MQC_Matrix_HaveReal(Af)) then
            AR = Af%MatR
          Else
            AR = real(Af%MatI,kind=real64)
          EndIf
          If(MQC_Matrix_HaveReal(Bf)) then
            BR = Bf%MatR
          Else
            BR = real(Bf%MatI,kind=real64)
          EndIf
          call DGEMM('N','N',N32,M32,N32,oneR,AR,N32,BR,N32,zeroR,TR,N32)
          CR = zeroR
          call DGEMMT('L','T','N',M32,N32,oneR,BR,N32,TR,N32,zeroR,CR,M32)
          If(structure.eq.'hermitian') then
            Call MQC_Allocate_Matrix(M,M,C,'Real','StorSymm')
          Else
            Call MQC_Allocate_Matrix(M,M,C,'Real','StorAsym')
          EndIf
          Do I = 1, M
            II = (I*(I-1))/2
            Do J = 1, I-1
              C%MatR(II+J,1) = CR(I,J)
            EndDo
            If(structure.eq.'hermitian') then
              C%MatR(II+I,1) = CR(I,I)
            Else
              C%MatR(II+I,1) = zeroR
            EndIf
          EndDo
        EndIf
      EndIf
!
      EndIf
      End Function MQC_Matrix_Hermitian_Sandwich
!
!
!     PROCEDURE MQC_MatrixVectorDotProduct
!
!>    \brief <b> MQC_MatrixVectorDotProduct is a function that computes the inner
!>    product of a MQC matrix and a MQC vector</b>
!>
!>    \par Purpose:
!     =============
!>
!>    \verbatim
!>       
!>    MQC_MatrixVectorDotProduct is a function that computes the inner product of 
!>    a MQC matrix and a MQC vector.
!>
!>    \endverbatim
!
!     Arguments:
!     ==========
!>    \param[in] MA
!>    \verbatim
!>        MA is Type(MQC_Matrix)
!>        The MQC matrix multiply.
!>    \endverbatim
!>
!>    \param[in] VB
!>    \verbatim
!>        VB is Type(MQC_Vector)
!>        The MQC vector.
!>    \endverbatim
!
!     Authors:
!     ========
!>    \author X. Sheng
!>    \date 2017
!
      Function MQC_MatrixVectorDotProduct(MA,VB) Result(VC)
!
      Implicit None
      Type(MQC_Matrix),Intent(In)::MA
      Type(MQC_Vector),Intent(In)::VB
      Type(MQC_Vector)::VC,VBreal
      Type(MQC_Matrix)::MAreal,Tmp1
      Integer(kind=int64),Allocatable::Result(:,:)

!     StorZero operand: result without the storage dispatch
      If(MA%Storage.eq.'StorZero') then
        If(MA%NCol.ne.VB%Length) Call MQC_Error_I('Matrix and vector are not conformable for &
          &multiplication', 6, 'MA%NCol', MA%NCol, 'VB%Length', VB%Length)
        If(.not.VB%Column) Call MQC_Error_I('Row type vector are not conformable for a right &
          &size multiplication with a matrix', 6)
        Call MQC_Allocate_Vector(MA%NRow,VC,MQC_Matrix_Promote_Type(MA%Data_Type,VB%Data_Type))
        If(Allocated(VC%VecI)) VC%VecI = 0
        If(Allocated(VC%VecR)) VC%VecR = 0.0
        If(Allocated(VC%VecC)) VC%VecC = (0.0,0.0)
      Else
      If (MA%NCol /= VB%Length) then
        Call MQC_Error_I('Matrix and vector are not conformable for multiplication', 6, &
             'MA%NCol', MA%NCol, &
             'VB%Length', VB%Length)
      EndIf
      If (.not. VB%Column) then
        Call MQC_Error_I('Row type vector are not conformable for a right size multiplication with a matrix', 6)
      EndIf
      

      If (MQC_Matrix_HaveInteger(MA)) MAreal = MQC_Cast_Real(MA)
      If (MQC_Vector_HaveInteger(VB)) VBreal = MQC_Cast_Real(VB)
      If (MQC_Matrix_HaveReal(MA) .and. MQC_Vector_HaveReal(VB)) then
        Call MQC_Allocate_Vector(MA%NRow,VC,'Real')
        If ((MA%Storage.eq.'StorFull'.or.MA%Storage.eq.'StorNoSym')) then
          call DGemV('N',int(MA%NRow,kind=MQC_BlasInt),int(MA%NCol,kind=MQC_BlasInt),1.0,MA%MatR,&
               int(MA%NRow,kind=MQC_BlasInt),VB%VecR,int(1,kind=MQC_BlasInt),0.0,VC%VecR,&
               int(1,kind=MQC_BlasInt))
        ElseIf (MA%Storage.eq.'StorSymm'.or.MA%Storage.eq.'StorAsym' .or. &
            MA%Storage.eq.'StorHerm' .or. MA%Storage.eq.'StorAhrm') then
          Tmp1 = MA
          Call MQC_Matrix_Symm2Full(Tmp1)
          call DSymV('L',int(MA%NRow,kind=MQC_BlasInt),1.0,Tmp1%MatR,int(MA%NRow,kind=MQC_BlasInt),VB%VecR,&
               int(1,kind=MQC_BlasInt),0.0,VC%VecR,int(1,kind=MQC_BlasInt))
          Call MQC_Deallocate_Matrix(Tmp1)
        elseif (MA%Storage.eq.'StorDiag') then
          VC%vecR = MA%matR(:,1) * VB%vecR
        EndIf
      ElseIf (MQC_Matrix_HaveReal(MA) .and. MQC_Vector_HaveInteger(VB)) then
        Call MQC_Allocate_Vector(MA%NRow,VC,'Real')
        If ((MA%Storage.eq.'StorFull'.or.MA%Storage.eq.'StorNoSym')) then
          call DGemV('N',int(MA%NRow,kind=MQC_BlasInt),int(MA%NCol,kind=MQC_BlasInt),1.0,MA%MatR,&
               int(MA%NRow,kind=MQC_BlasInt),VBreal%VecR,int(1,kind=MQC_BlasInt),0.0,VC%VecR,&
               int(1,kind=MQC_BlasInt))
        ElseIf (MA%Storage.eq.'StorSymm'.or.MA%Storage.eq.'StorAsym' .or. &
            MA%Storage.eq.'StorHerm' .or. MA%Storage.eq.'StorAhrm') then
          Tmp1 = MA
          Call MQC_Matrix_Symm2Full(Tmp1)
          call DSymV('L',int(MA%NRow,kind=MQC_BlasInt),1.0,Tmp1%MatR,int(MA%NRow,kind=MQC_BlasInt),&
               VBreal%VecR,int(1,kind=MQC_BlasInt),0.0,VC%VecR,int(1,kind=MQC_BlasInt))
          Call MQC_Deallocate_Matrix(Tmp1)
        elseif (MA%Storage.eq.'StorDiag') then
          VC%vecR = MA%matR(:,1) * VB%vecI
        EndIf
      ElseIf (MQC_Matrix_HaveInteger(MA) .and. MQC_Vector_HaveReal(VB)) then
        Call MQC_Allocate_Vector(MA%NRow,VC,'Real')
        If ((MA%Storage.eq.'StorFull'.or.MA%Storage.eq.'StorNoSym')) then
          call DGemV('N',int(MA%NRow,kind=MQC_BlasInt),int(MA%NCol,kind=MQC_BlasInt),1.0,MAreal%MatR,&
               int(MA%NRow,kind=MQC_BlasInt),VB%VecR,int(1,kind=MQC_BlasInt),0.0,VC%VecR,&
               int(1,kind=MQC_BlasInt))
        ElseIf (MA%Storage.eq.'StorSymm'.or.MA%Storage.eq.'StorAsym' .or. &
            MA%Storage.eq.'StorHerm' .or. MA%Storage.eq.'StorAhrm') then
          Call MQC_Matrix_Symm2Full(MAreal)
          call DSymV('L',int(MA%NRow,kind=MQC_BlasInt),1.0,MAreal%MatR,int(MA%NRow,kind=MQC_BlasInt),VB%VecR,&
               int(1,kind=MQC_BlasInt),0.0,VC%VecR,int(1,kind=MQC_BlasInt))
          Call MQC_Matrix_Full2Symm(MAreal)
        elseif (MA%Storage.eq.'StorDiag') then
          VC%vecR = MA%matI(:,1) * VB%vecR
        EndIf
      ElseIf (MQC_Matrix_HaveInteger(MA) .and. MQC_Vector_HaveInteger(VB)) then
        Call MQC_Allocate_Vector(MA%NRow,VC,'Integer')
        Allocate(Result(MA%NRow,1))
        If ((MA%Storage.eq.'StorFull'.or.MA%Storage.eq.'StorNoSym')) then
          Result = MatMul(MA%MatI,Reshape(VB%VecI,[MA%NCol,1]))
          VC%VecI = Result(:,1)
          !call dgemv('N',MA%nrow,MA%ncol,1.0,MA%mati,MA%nrow,VB%veci,1,0.0,VC%veci,1)
        ElseIf (MA%Storage.eq.'StorSymm'.or.MA%Storage.eq.'StorAsym' .or. &
            MA%Storage.eq.'StorHerm' .or. MA%Storage.eq.'StorAhrm') then
          Tmp1 = MA
          Call MQC_Matrix_Symm2Full(Tmp1)
          Result = MatMul(Tmp1%MatI,Reshape(VB%VecI,[MA%NCol,1]))
          Call MQC_Deallocate_Matrix(Tmp1)
          VC%VecI = Result(:,1)
          !call dsymv('L',MA%nrow,1.0,MQC_Matrix_Symm2Full_func(MA), &
           !MA%nrow,VB%veci,1,0.0,VC%veci,1)
        elseif (MA%Storage.eq.'StorDiag') then
          VC%vecI = MA%matI(:,1) * VB%vecI
        EndIf
      ElseIf (MQC_Matrix_HaveInteger(MA) .and. MQC_Vector_HaveComplex(VB)) then
        Call MQC_Allocate_Vector(MA%NRow,VC,'Complex')
        If ((MA%Storage.eq.'StorFull'.or.MA%Storage.eq.'StorNoSym')) then
          VC%VecC = MatMul(MA%MatI,VB%VecC)
        ElseIf (MA%Storage.eq.'StorSymm'.or.MA%Storage.eq.'StorAsym' .or. &
            MA%Storage.eq.'StorHerm' .or. MA%Storage.eq.'StorAhrm') then
          Tmp1 = MA
          Call MQC_Matrix_Symm2Full(Tmp1)
          VC%VecC = MatMul(Tmp1%MatI,VB%VecC)
          Call MQC_Deallocate_Matrix(Tmp1)
        elseif (MA%Storage.eq.'StorDiag') then
          VC%vecC = MA%matI(:,1) * VB%vecC
        EndIf
      ElseIf (MQC_Matrix_HaveReal(MA) .and. MQC_Vector_HaveComplex(VB)) then
        Call MQC_Allocate_Vector(MA%NRow,VC,'Complex')
        If ((MA%Storage.eq.'StorFull'.or.MA%Storage.eq.'StorNoSym')) then
          VC%VecC = MatMul(MA%MatR,VB%VecC)
        ElseIf (MA%Storage.eq.'StorSymm'.or.MA%Storage.eq.'StorAsym' .or. &
            MA%Storage.eq.'StorHerm' .or. MA%Storage.eq.'StorAhrm') then
          Tmp1 = MA
          Call MQC_Matrix_Symm2Full(Tmp1)
          VC%VecC = MatMul(Tmp1%MatR,VB%VecC)
          Call MQC_Deallocate_Matrix(Tmp1)
        elseif (MA%Storage.eq.'StorDiag') then
          VC%vecC = MA%matR(:,1) * VB%vecC
        EndIf
      ElseIf (MQC_Matrix_HaveComplex(MA) .and. MQC_Vector_HaveInteger(VB)) then
        Call MQC_Allocate_Vector(MA%NRow,VC,'Complex')
        If ((MA%Storage.eq.'StorFull'.or.MA%Storage.eq.'StorNoSym')) then
          VC%VecC = MatMul(MA%MatC,VB%VecI)
        ElseIf (MA%Storage.eq.'StorSymm'.or.MA%Storage.eq.'StorAsym' .or. &
            MA%Storage.eq.'StorHerm' .or. MA%Storage.eq.'StorAhrm') then
          Tmp1 = MA
          Call MQC_Matrix_Symm2Full(Tmp1)
          VC%VecC = MatMul(Tmp1%MatC,VB%VecI)
          Call MQC_Deallocate_Matrix(Tmp1)
        elseif (MA%Storage.eq.'StorDiag') then
          VC%vecC = MA%matC(:,1) * VB%vecI
        EndIf
      ElseIf (MQC_Matrix_HaveComplex(MA) .and. MQC_Vector_HaveReal(VB)) then
        Call MQC_Allocate_Vector(MA%NRow,VC,'Complex')
        If ((MA%Storage.eq.'StorFull'.or.MA%Storage.eq.'StorNoSym')) then
          VC%VecC = MatMul(MA%MatC,VB%VecR)
        ElseIf (MA%Storage.eq.'StorSymm'.or.MA%Storage.eq.'StorAsym' .or. &
            MA%Storage.eq.'StorHerm' .or. MA%Storage.eq.'StorAhrm') then
          Tmp1 = MA
          Call MQC_Matrix_Symm2Full(Tmp1)
          VC%VecC = MatMul(Tmp1%MatC,VB%VecR)
          Call MQC_Deallocate_Matrix(Tmp1)
        elseif (MA%Storage.eq.'StorDiag') then
          VC%vecC = MA%matC(:,1) * VB%vecR
        EndIf
      ElseIf (MQC_Matrix_HaveComplex(MA) .and. MQC_Vector_HaveComplex(VB)) then
        Call MQC_Allocate_Vector(MA%NRow,VC,'Complex')
        If ((MA%Storage.eq.'StorFull'.or.MA%Storage.eq.'StorNoSym')) then
          VC%VecC = MatMul(MA%MatC,VB%VecC)
        ElseIf (MA%Storage.eq.'StorSymm'.or.MA%Storage.eq.'StorAsym' .or. &
            MA%Storage.eq.'StorHerm' .or. MA%Storage.eq.'StorAhrm') then
          Tmp1 = MA
          Call MQC_Matrix_Symm2Full(Tmp1)
          VC%VecC = MatMul(Tmp1%MatC,VB%VecC)
          Call MQC_Deallocate_Matrix(Tmp1)
        elseif (MA%Storage.eq.'StorDiag') then
          VC%vecC = MA%matC(:,1) * VB%vecC
        EndIf
      EndIf

      EndIf
      End Function MQC_MatrixVectorDotProduct
!
!
!     PROCEDURE MQC_VectorMatrixDotProduct
!
!>    \brief <b> MQC_VectorMatrixDotProduct is a function that computes the inner
!>    product of a MQC vector and a MQC matrix</b>
!>
!>    \par Purpose:
!     =============
!>
!>    \verbatim
!>       
!>    MQC_VectorMatrixDotProduct is a function that computes the inner product of 
!>    a MQC vector and a MQC matrix.
!>
!>    \endverbatim
!
!     Arguments:
!     ==========
!>    \param[in] VA
!>    \verbatim
!>        VA is Type(MQC_Vector)
!>        The MQC vector to multiply.
!>    \endverbatim
!>
!>    \param[in] MB
!>    \verbatim
!>        MB is Type(MQC_Matrix)
!>        The MQC matrix to multiply.
!>    \endverbatim
!
!     Authors:
!     ========
!>    \author X. Sheng
!>    \date 2017
!
      Function MQC_VectormatrixDotProduct(VA,MB) Result(VC)
!
      Implicit None
      Type(MQC_Matrix),Intent(In)::MB
      Type(MQC_Vector),Intent(In)::VA
      Type(MQC_Vector)::VC,VAreal
      Type(MQC_Matrix)::MBreal,Tmp1
      Integer(kind=int64),Allocatable::Result(:,:)

!     StorZero operand: result without the storage dispatch
      If(MB%Storage.eq.'StorZero') then
        If(VA%Length.ne.MB%NRow) Call MQC_Error_I('Matrix and vector are not conformable for &
          &multiplication', 6, 'VA%Length', VA%Length, 'MB%NRow', MB%NRow)
        If(VA%Column) Call MQC_Error_I('Column type vector are not conformable for a left size &
          &multiplication with a matrix', 6)
        Call MQC_Allocate_Vector(MB%NCol,VC,MQC_Matrix_Promote_Type(VA%Data_Type,MB%Data_Type))
        If(Allocated(VC%VecI)) VC%VecI = 0
        If(Allocated(VC%VecR)) VC%VecR = 0.0
        If(Allocated(VC%VecC)) VC%VecC = (0.0,0.0)
        VC = MQC_Vector_Transpose(VC)
      Else
      If ( VA%Length /= MB%NRow) then
        Call MQC_Error_i('Matrix and vector are not conformable for multiplication', 6, &
             'VA%Length', VA%Length, &
             'MB%NRow', MB%NRow)
      EndIf
      If (VA%Column) then
        Call MQC_Error_I('Column type vector are not conformable for a left size multiplication with a matrix', 6)
      EndIf


      If (MQC_Matrix_HaveReal(MB) .and. MQC_Vector_HaveReal(VA)) then
        Call MQC_Allocate_Vector(MB%NCol,VC,'Real')
        VC = MQC_Vector_Transpose(VC)
        If ((MB%Storage.eq.'StorFull'.or.MB%Storage.eq.'StorNoSym')) then
          call DGemV('T',int(MB%NRow,kind=MQC_BlasInt),int(MB%NCol,kind=MQC_BlasInt),1.0,MB%MatR,&
               int(MB%NRow,kind=MQC_BlasInt),VA%VecR,int(1,kind=MQC_BlasInt),0.0,VC%VecR,&
               int(1,kind=MQC_BlasInt))
        ElseIf (MB%Storage.eq.'StorSymm'.or.MB%Storage.eq.'StorAsym' .or. &
            MB%Storage.eq.'StorHerm' .or. MB%Storage.eq.'StorAhrm') then
          Tmp1 = MB
          Call MQC_Matrix_Symm2Full(Tmp1)
          call DSymV('L',int(MB%NRow,kind=MQC_BlasInt),1.0,Tmp1%MatR,int(MB%NRow,kind=MQC_BlasInt),VA%VecR,&
               int(1,kind=MQC_BlasInt),0.0,VC%VecR,int(1,kind=MQC_BlasInt))
          Call MQC_Deallocate_Matrix(Tmp1)
        elseif (MB%Storage.eq.'StorDiag') then
          VC%vecR = MB%matR(:,1) * VA%vecR
        EndIf
      ElseIf (MQC_Matrix_HaveInteger(MB) .and. MQC_Vector_HaveReal(VA)) then
        Call MQC_Allocate_Vector(MB%NCol,VC,'Real')
        VC = MQC_Vector_Transpose(VC)
        If ((MB%Storage.eq.'StorFull'.or.MB%Storage.eq.'StorNoSym')) then
          call DGemV('T',int(MB%NRow,kind=MQC_BlasInt),int(MB%NCol,kind=MQC_BlasInt),1.0,MBreal%MatR,&
               int(MB%NRow,kind=MQC_BlasInt),VA%VecR,int(1,kind=MQC_BlasInt),0.0,VC%VecR,&
               int(1,kind=MQC_BlasInt))
        ElseIf (MB%Storage.eq.'StorSymm'.or.MB%Storage.eq.'StorAsym' .or. &
            MB%Storage.eq.'StorHerm' .or. MB%Storage.eq.'StorAhrm') then
          Call MQC_Matrix_Symm2Full(MBreal)
          call DSymV('L',int(MB%NRow,kind=MQC_BlasInt),1.0,MBreal%MatR,int(MB%NRow,kind=MQC_BlasInt),VA%VecR,&
               int(1,kind=MQC_BlasInt),0.0,VC%VecR,int(1,kind=MQC_BlasInt))
          Call MQC_Matrix_Full2Symm(MBreal)
        elseif (MB%Storage.eq.'StorDiag') then
          VC%vecR = MB%matI(:,1) * VA%vecR
        EndIf
      ElseIf (MQC_Matrix_HaveReal(MB) .and. MQC_Vector_HaveInteger(VA)) then
        Call MQC_Allocate_Vector(MB%NCol,VC,'Real')
        VC = MQC_Vector_Transpose(VC)
        If ((MB%Storage.eq.'StorFull'.or.MB%Storage.eq.'StorNoSym')) then
          call DGemV('T',int(MB%nrow,kind=MQC_BlasInt),int(MB%ncol,kind=MQC_BlasInt),1.0,MB%matr,&
               int(MB%nrow,kind=MQC_BlasInt),VAreal%vecr,int(1,kind=MQC_BlasInt),0.0,VC%vecr,&
               int(1,kind=MQC_BlasInt))
        ElseIf (MB%Storage.eq.'StorSymm'.or.MB%Storage.eq.'StorAsym' .or. &
            MB%Storage.eq.'StorHerm' .or. MB%Storage.eq.'StorAhrm') then
          Tmp1 = MB
          Call MQC_Matrix_Symm2Full(Tmp1)
          call DSymV('L',int(MB%NRow,kind=MQC_BlasInt),1.0,Tmp1%MatR,int(MB%NRow,kind=MQC_BlasInt),&
               VAreal%VecR,int(1,kind=MQC_BlasInt),0.0,VC%VecR,int(1,kind=MQC_BlasInt))
          Call MQC_Deallocate_Matrix(Tmp1)
        elseif (MB%Storage.eq.'StorDiag') then
          VC%vecR = MB%matR(:,1) * VA%vecI
        EndIf
      ElseIf (MQC_Matrix_HaveInteger(MB) .and. MQC_Vector_HaveInteger(VA)) then
        Call MQC_Allocate_Vector(MB%NCol,VC,'Integer')
        VC = MQC_Vector_Transpose(VC)
        Allocate(Result(1,MB%NCol))
        If ((MB%Storage.eq.'StorFull'.or.MB%Storage.eq.'StorNoSym')) then
          Result = MatMul(Reshape(VA%VecI,[1,MB%NRow]),MB%MatI)
          VC%VecI = Result(1,:)
          !call dgemv('T',MB%nrow,MB%ncol,1.0,MB%mati,MB%nrow,VA%veci,1,0.0,VC%veci,1)
        ElseIf (MB%Storage.eq.'StorSymm'.or.MB%Storage.eq.'StorAsym' .or. &
            MB%Storage.eq.'StorHerm' .or. MB%Storage.eq.'StorAhrm') then
          Tmp1 = MB
          Call MQC_Matrix_Symm2Full(Tmp1)
          Result = MatMul(Reshape(VA%VecI,[1,MB%NRow]),Tmp1%MatI)
          Call MQC_Deallocate_Matrix(Tmp1)
          VC%VecI = Result(1,:)
          !call dsymv('L',MB%nrow,1.0,MQC_matrix_Symm2Full_func(MB), &
           !MB%nrow,VA%veci,1,0.0,VC%veci,1)
        elseif (MB%Storage.eq.'StorDiag') then
         VC%vecI = MB%matI(:,1) * VA%vecI
        EndIf
      ElseIf (MQC_Vector_HaveInteger(VA) .and. MQC_Matrix_HaveComplex(MB)) then
        Call MQC_Allocate_Vector(MB%NCol,VC,'Complex')
        VC = MQC_Vector_Transpose(VC)
        If ((MB%Storage.eq.'StorFull'.or.MB%Storage.eq.'StorNoSym')) then
          VC%VecC = MatMul(VA%VecI,MB%MatC)
        ElseIf (MB%Storage.eq.'StorSymm'.or.MB%Storage.eq.'StorAsym' .or. &
            MB%Storage.eq.'StorHerm' .or. MB%Storage.eq.'StorAhrm') then
          Tmp1 = MB
          Call MQC_Matrix_Symm2Full(Tmp1)
          VC%VecC = MatMul(VA%VecI,Tmp1%MatC)
          Call MQC_Deallocate_Matrix(Tmp1)
        elseif (MB%Storage.eq.'StorDiag') then
          VC%vecC = VA%vecI * MB%matC(:,1) 
        EndIf
      ElseIf (MQC_Vector_HaveReal(VA) .and. MQC_Matrix_HaveComplex(MB)) then
        Call MQC_Allocate_Vector(MB%NCol,VC,'Complex')
        VC = MQC_Vector_Transpose(VC)
        If ((MB%Storage.eq.'StorFull'.or.MB%Storage.eq.'StorNoSym')) then
          VC%VecC = MatMul(VA%VecR,MB%MatC)
        ElseIf (MB%Storage.eq.'StorSymm'.or.MB%Storage.eq.'StorAsym' .or. &
            MB%Storage.eq.'StorHerm' .or. MB%Storage.eq.'StorAhrm') then
          Tmp1 = MB
          Call MQC_Matrix_Symm2Full(Tmp1)
          VC%VecC = MatMul(VA%VecR,Tmp1%MatC)
          Call MQC_Deallocate_Matrix(Tmp1)
        elseif (MB%Storage.eq.'StorDiag') then
          VC%vecC = VA%VecR * MB%matC(:,1)
        EndIf
      ElseIf (MQC_Vector_HaveComplex(VA) .and. MQC_Matrix_HaveInteger(MB)) then
        Call MQC_Allocate_Vector(MB%NCol,VC,'Complex')
        VC = MQC_Vector_Transpose(VC)
        If ((MB%Storage.eq.'StorFull'.or.MB%Storage.eq.'StorNoSym')) then
          VC%VecC = MatMul(VA%VecC,MB%MatI)
        ElseIf (MB%Storage.eq.'StorSymm'.or.MB%Storage.eq.'StorAsym' .or. &
            MB%Storage.eq.'StorHerm' .or. MB%Storage.eq.'StorAhrm') then
          Tmp1 = MB
          Call MQC_Matrix_Symm2Full(Tmp1)
          VC%VecC = MatMul(VA%VecC,Tmp1%MatI)
          Call MQC_Deallocate_Matrix(Tmp1)
        elseif (MB%Storage.eq.'StorDiag') then
          VC%vecC = VA%vecC * MB%matI(:,1) 
        EndIf
      ElseIf (MQC_Vector_HaveComplex(VA) .and. MQC_Matrix_HaveReal(MB)) then
        Call MQC_Allocate_Vector(MB%NCol,VC,'Complex')
        VC = MQC_Vector_Transpose(VC)
        If ((MB%Storage.eq.'StorFull'.or.MB%Storage.eq.'StorNoSym')) then
          VC%VecC = MatMul(VA%VecC,MB%MatR)
        ElseIf (MB%Storage.eq.'StorSymm'.or.MB%Storage.eq.'StorAsym' .or. &
            MB%Storage.eq.'StorHerm' .or. MB%Storage.eq.'StorAhrm') then
          Tmp1 = MB
          Call MQC_Matrix_Symm2Full(Tmp1)
          VC%VecC = MatMul(VA%VecC,Tmp1%MatR)
          Call MQC_Deallocate_Matrix(Tmp1)
        elseif (MB%Storage.eq.'StorDiag') then
          VC%vecC = VA%VecC * MB%matR(:,1)
        EndIf
      ElseIf (MQC_Vector_HaveComplex(VA) .and. MQC_Matrix_HaveComplex(MB)) then
        Call MQC_Allocate_Vector(MB%NCol,VC,'Complex')
        VC = MQC_Vector_Transpose(VC)
        If ((MB%Storage.eq.'StorFull'.or.MB%Storage.eq.'StorNoSym')) then
          VC%VecC = MatMul(VA%VecC,MB%MatC)
        ElseIf (MB%Storage.eq.'StorSymm'.or.MB%Storage.eq.'StorAsym' .or. &
            MB%Storage.eq.'StorHerm' .or. MB%Storage.eq.'StorAhrm') then
          Tmp1 = MB
          Call MQC_Matrix_Symm2Full(Tmp1)
          VC%VecC = MatMul(VA%VecC,Tmp1%MatC)
          Call MQC_Deallocate_Matrix(Tmp1)
        elseif (MB%Storage.eq.'StorDiag') then
          VC%vecC = VA%VecC * MB%matC(:,1)
        EndIf
      EndIf

      EndIf
      End Function MQC_VectorMatrixDotProduct
