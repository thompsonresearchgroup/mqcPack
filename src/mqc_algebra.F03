              call mqc_allocate_matrix(A%NRow,A%NCol,C,'Real','StorFull')
              do i = 1, A%NRow
                do j = 1, A%NCol
                  C%matR(i,j) = B%matR(i,j) * A%matI(symIndexHash(i,j),1)
                  If(j.gt.i) C%matR(i,j) = (-1)*C%matR(i,j)
                enddo
              enddo
            else if (B%storage .eq. 'StorSymm'.or.B%storage .eq. 'StorHerm') then
